<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="carSpecification" class="car.example.setter.injection.Specification">
        <property name="make" value="Toyota"/>
        <property name="model" value="Corolla-2"/>
    </bean>

    <bean id="myCar" class="car.example.setter.injection.Car">
        <!--
        Carクラスの「specification」プロパティに、
        「carSpecification」Beanを注入する。

        name="specification"
            → Carクラスのspecificationプロパティを指定。

        ref="carSpecification"
            → Springコンテナに登録されている
              id="carSpecification" のBeanを参照する。

        そのため、Springは内部的に
        CarクラスのsetSpecification(...)を呼び出す。
        -->
        <property name="specification" ref="carSpecification"/>
    </bean>

</beans>