<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="specification" class="com.example.autowire.name.Specification">
        <property name="make" value="Toyota"/>
        <property name="model" value="Corolla"/>
    </bean>

    <!--
        autowire="byName" を指定すると、
        Carクラスのプロパティ名と一致するBean IDを
        Springが自動的に探して注入する。

        この例では、

        Carクラス:
            private Specification specification;

        Spring Bean:
            id="specification"

        となっているため、

            specification
                    ↓
            id="specification"
                    ↓
            Car.setSpecification(specification)

        というSetter Injectionが自動的に行われる。
    -->
    <bean id="myCar" class="com.example.autowire.name.Car" autowire="byName">
    </bean>

</beans>